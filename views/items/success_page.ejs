 <div class="page-content" style="margin: 40px auto;">
   
    <div class="container-xxl">
        <div>
            <div class="modal-dialog" style="display: flex; justify-content: center;">
                <div class="modal-content">
                    <div class="modal-body">
                        <div class="card border-0 mb-0" style="width: 100%; max-width: 500px; margin: 0 auto;">
                            <div class="card-body">
                                <form class="">
                                    <div class="row align-items-center">
                                        <div class="col-lg-12">
                                            <div class="check-icon text-center">
                                                <img src="assets/images/tripple44fc-pic.png"  style="height: 70px;" alt="" class="img-fluid">
                                                <h4 class="fw-semibold mt-3">Thank You !</h4>
                                                <p><span class="text-dark fw-medium"></span><%= successMessage %></p>
                                                <a href="/cart" class="btn btn-primary mt-3">Return to Cart</a>
                                            </div>
                                            <hr>
                                        </div>
                                    </div>
                                </form>
                            </div>
                            
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <script>
        // Redirect after 5 seconds (5000 milliseconds)
        setTimeout(() => {
            window.location.href = "/"; // Replace with your desired URL
        }, 5000);
    </script>
</div>
 