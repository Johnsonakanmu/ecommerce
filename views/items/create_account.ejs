<div class="container h-100 p-3">
  <div class="row h-100">
    <div class="col-xxl-7">
      <div class="row h-100">
        <div class="col-lg-8 py-lg-5">
          <div class="d-flex flex-column h-100">
            <div class="auth-logo mb-4">
              <a>
                <img src="assets/images/tripple44fc-pic.png" style="height: 70px;" alt="logo dark">
              </a>
            </div>


            <h2 class="fw-bold fs-24">Sign Up</h2>
            <p class="text-muted mt-1 mb-4">Welcome to the user creation process! Please fill out the required fields to set up your account.</p>

            <% if (message) { %>
              <div class="alert alert-<%= type %>">
                <%= message %>
              </div>
            <% } %>

            <div class="mb-5">
              <form action="/create_account" method="POST" class="authentication-form">

                <div class="row">
                  <div class="col-md-12 mb-2">
                    <label class="form-label" for="fullName">Full Name</label>
                    <input type="text" id="fullName" name="fullName" class="form-control" placeholder="Full Name:" required value="<%= typeof user !== 'undefined' && user ? user.fullName : '' %>">
                  </div>
                </div>

                <div class="row">
                  <div class="col-md-12 mb-2">
                    <label class="form-label" for="email">Email</label>
                    <input type="email" id="email" name="email" class="form-control" placeholder="Email:" 
                    required value="<%= typeof user !== 'undefined' && user ? user.email : '' %>">
                  </div>
                </div>

                <div class="row">
                  <div class="col-md-6 mb-2">
                    <label class="form-label" for="phone">Phone</label>
                    <input type="text" id="phone" name="phone" class="form-control" placeholder="Phone No:" 
                    required value="<%= typeof user !== 'undefined' && user ? user.phone : '' %>">
                  </div>
                  <div class="col-md-6 mb-2">
                    <label class="form-label" for="state">State</label>
                    <input type="text" id="state" name="state" class="form-control" placeholder="State:" 
                    required value="<%= typeof shippingDetails !== 'undefined' && shippingDetails ? shippingDetails.state : '' %>">
                  </div>
                </div>

                <div class="row">
                  <div class="col-md-6 mb-2">
                    <label class="form-label" for="city">City</label>
                    <input type="text" id="city" name="city" class="form-control" placeholder="City:" 
                    required value="<%= typeof shippingDetails !== 'undefined' && shippingDetails ? shippingDetails.city : '' %>">
                  </div>
                  <div class="col-md-6 mb-2">
                    <label class="form-label" for="country">Country</label>
                    <input type="text" id="country" name="country" class="form-control" placeholder="Country:" 
                    required value="<%= typeof shippingDetails !== 'undefined' && shippingDetails ? shippingDetails.country : '' %>">
                  </div>
                </div>

                <div class="row">
                  <div class="col-md-6 mb-2">
                    <!-- Password input -->
                    <label class="form-label" for="password">Password</label>
                     <input type="password" name="password" class="form-control" placeholder="Password:">
                     <% if (typeof errors !== 'undefined' && errors.passwordLength) { %>
                      <div class="error-message"><%= errors.passwordLength %></div>
                   <% } %>
                  </div>
                  <div class="col-md-6 mb-2">
                    <!-- Confirm Password input -->
                    <label class="form-label" for="confirmPassword">Confirm Password</label>
                    <input type="password" name="crfpassword" class="form-control" placeholder="Confirm Password:">
                    <% if (typeof errors !== 'undefined' && errors.confirmPassword) { %>
                        <div class="error-message"><%= errors.confirmPassword %></div>
                    <% } %>
                </div>
                </div>

                <div class="row">
                  <div class="col-md-12 mb-2">
                    <label class="form-label" for="address">Address</label>
                    <input type="text" id="address" name="address" class="form-control" placeholder="Address:" required
                    value="<%= typeof shippingDetails !== 'undefined' && shippingDetails ? shippingDetails.address : '' %>" 
                    >
                  </div>
                </div>

                <div class="row">
                  <!-- <div class="col-md-6 mb-2">
                    <a href="/login" class="btn btn-outline-secondary width-xl">Login</a>
                  </div> -->
                  <div class="col-md-12 mb-2">
                    <button class="btn btn-soft-primary" style="width: 100%;" type="submit">Create Account</button>
                  </div>
                </div>
                  <!-- Display general error if it exists -->
                  <!-- General error display -->
                  <% if (typeof errors !== 'undefined' && errors.general) { %>
                   <div class="error-message"><%= errors.general %></div>
                    <% } %>
              </form>
            </div>

            <p class=" text-danger text-center" style="margin-top: -50px;">I already have an account  <a href="login" class="text-dark fw-bold ms-1">Sign In</a></p>

          </div>
        </div>
      </div>
    </div>

    <!-- Promo Code and Order Summary -->
    <div class="col-lg-4" style="margin-top: 100px;">
      <div class="card text-center bg-primary overflow-hidden z-1">
        <div class="card-body p-4">
          <h4 class="card-title text-white">Have a Promo Code?</h4>
          <div class="position-relative mt-3">
            <div class="form-button">
              <form class="d-flex align-items-center justify-content-center">
                <input type="text" class="form-control w-50 border-0 rounded bg-light text-white bg-opacity-25" placeholder="code" required="" value="CODE123">
                <button type="button" data-toast data-toast-text="Your Promo Code Applied Successfully" data-toast-gravity="top" data-toast-position="center" data-toast-className="success" data-toast-duration="3000" class="btn btn-light ms-2 rounded-2">
                  Apply
                </button>
              </form>
            </div>
          </div>
        </div>
      </div>

      <div class="card" >
        <div class="card-header">
          <h4 class="card-title">Order Summary</h4>
        </div>
        <div class="card-body">
          <div class="table-responsive">
            <table class="table mb-0">
              <tbody>
                <tr>
                  <td class="px-0">
                    <p class="d-flex mb-0 align-items-center gap-1"><iconify-icon icon="solar:clipboard-text-broken"></iconify-icon> Sub Total:</p>
                  </td>
                  <td class="text-end text-dark fw-medium px-0">#<%= subtotal || '0.00' %></td>
                </tr>
              </tbody>
            </table>
          </div>
        </div>
        <div class="card-footer bg-light-subtle border-top">
          <div class="d-flex align-items-center justify-content-between">
            <div>
              <p class="fw-medium text-dark mb-0">Total Amount</p>
            </div>
            <div>
              <p class="fw-medium text-dark mb-0">#<%= subtotal || '0.00' %></p>
            </div>
          </div>
          <div class="alert alert-warning alert-icon mt-3 mb-0" role="alert">
            <div class="d-flex align-items-center">
              <div class="avatar-sm rounded bg-warning d-flex justify-content-center align-items-center fs-22 me-2 flex-shrink-0">
                <iconify-icon icon="solar:kick-scooter-broken" class="align-middle text-white"></iconify-icon>
              </div>
              <div class="flex-grow-1">
                <!-- Estimated Delivery by <%= estimatedDeliveryDate || 'N/A' %> -->
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
