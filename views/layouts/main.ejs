<script>
  document.getElementById('checkout-form').addEventListener('submit', async function (e) {
    e.preventDefault(); // Prevent default form submission

    try {
      // Send a POST request to the server to create the order
      const response = await fetch('/create-order', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json'
        },
        body: JSON.stringify({}) // Pass any necessary data (if required)
      });

      // Handle the response
      if (response.ok) {
        // Order created successfully, redirect to the order view page
        window.location.href = '/order';
      } else {
        const errorData = await response.text();
        alert('Failed to create order: ' + errorData);
      }
    } catch (err) {
      console.error('Error during order creation:', err);
    }
  });
</script>


<script>
  document.getElementById('submitBtn').addEventListener('click', function (e) {
    e.preventDefault(); // Prevent form submission
  
    // Get password and confirm password values
    const password = document.getElementById('password').value;
    const crfpassword = document.getElementById('crfpassword').value;
  
    // Clear previous error messages
    document.getElementById('passwordError').textContent = '';
    document.getElementById('confirmPasswordError').textContent = '';
  
    // Validation
    let isValid = true;
  
    // Check password length
    if (password.length < 4) {
      document.getElementById('passwordError').textContent = 'Password must be at least 4 characters long';
      isValid = false;
    }
  
    // Check if passwords match
    if (password !== crfpassword) {
      document.getElementById('confirmPasswordError').textContent = 'Passwords do not match';
      isValid = false;
    }
  
    // If valid, submit form
    if (isValid) {
      document.querySelector('form').submit();
    }
  });
  </script>


<script>
  function displayRating(rating) {
    const fullStar = 'bxs-star';
    const halfStar = 'bxs-star-half';
    const emptyStar = 'bx-star';

    const stars = document.querySelectorAll('.bx');
    const ratingScore = document.getElementById('rating-score');

    ratingScore.textContent = rating;

    stars.forEach((star, index) => {
        if (rating >= index + 1) {
            star.className = `bx ${fullStar} align-text-top fs-14 text-warning me-1`;
        } else if (rating > index && rating < index + 1) {
            star.className = `bx ${halfStar} align-text-top fs-14 text-warning me-1`;
        } else {
            star.className = `bx ${emptyStar} align-text-top fs-14 text-warning me-1`;
        }
    });
}
</script>

<script>
  document.getElementById('paystackBtn').addEventListener('click', function () {
    // Get the total amount in Kobo
    const totalAmount = document.getElementById('totalAmount').value * 100; // Convert to Kobo
    const email = document.getElementById('userEmail').value; // Get user email
    const publicKey = document.getElementById('paystackPublicKey').value; // Get Paystack public key

    // Initialize Paystack Payment
    const handler = PaystackPop.setup({
      key: publicKey, // Use the public key from the hidden input
      email: email, // Use the user's email from the hidden input
      amount: totalAmount, // Payment amount in Kobo
      currency: 'NGN',
      ref: '' + Math.floor(Math.random() * 1000000000 + 1), // Generate a random reference

      callback: function (response) {
        const reference = response.reference;

        // Send the reference to your backend for verification and order creation
        fetch('/verify-payment', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
          },
          body: JSON.stringify({
            reference: reference,
          }),
        })
        .then(response => response.json())
        .then(data => {
          if (data.status === 'success') {
            // alert('Payment successful, order created!');
            window.location.href = '/transaction_success'; // Redirect to order summary
          } else {
            window.location.href = '/transaction_failed';
          }
        })
        .catch(error => {
          console.error('Payment verification error:', error);
          // Redirect to failure page in case of an error
          window.location.href = '/transaction_failed';
        });
      },

      onClose: function () {
        alert('Payment was not completed');
      },
    });

    handler.openIframe(); // Open the Paystack popup
  });
</script>

<script>
  async function filterOrders() {
    const form = document.getElementById('filterForm');
    const formData = new FormData(form);
    const queryString = new URLSearchParams(formData).toString();

    try {
      const response = await fetch(`/dashboard?${queryString}`);
      
      if (!response.ok) {
        throw new Error('Network response was not ok');
      }

      const data = await response.text(); // Update if your server returns JSON
      document.getElementById('orderList').innerHTML = data; // Update this ID to your container
    } catch (error) {
      console.error('Error fetching orders:', error);
    }
  }
</script>


<script>
   async function searchOrders() {
    const searchValue = document.getElementById('search').value;

    try {
      const response = await fetch(`/dashboard?search=${encodeURIComponent(searchValue)}`);
      
      if (!response.ok) {
        throw new Error('Network response was not ok');
      }

      const data = await response.text(); // Update if your server returns JSON
      document.getElementById('orderList').innerHTML = data; // Update this ID to your container
    } catch (error) {
      console.error('Error fetching orders:', error);
    }
  }
</script>


<script>
  async function updateSoldAmount(productId) {
